# ── Node server ───────────────────────────────────────────────────────────────
NODE_PORT=3001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_PORT=27017
MONGO_ROOT_USERNAME=your_mongo_username
MONGO_ROOT_PASSWORD=your_mongo_password
MONGO_URI=mongodb://your_mongo_username:your_mongo_password@172.23.96.1:27017/cpen322-messenger?authSource=admin

# ── Rasa ──────────────────────────────────────────────────────────────────────
RASA_PORT=5005
RASA_ACTIONS_PORT=5055
RASA_WEBHOOK_URL=http://localhost:5005/webhooks/rest/webhook

# ── Sentiment service (FastAPI) ───────────────────────────────────────────────
SENTIMENT_SERVICE_URL=http://localhost:8001/analyze

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Room Assistant ──────────────────────────────────────────
# Model must support the Responses API web_search tool
ASSISTANT_MODEL=gpt-5.5
# "false" to answer without live web search
ASSISTANT_WEB_SEARCH=true
# max whispers per room per minute
ASSISTANT_RATE_LIMIT=6
# in 'session' memory mode, whispers are deleted this long after leaving a room
WHISPER_SESSION_GRACE_MS=30000
RASA_REPLY_MODE=demosk-your-key-here

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Chat App</title>
    <link href="https://fonts.googleapis.com/css2?family=Jersey+20&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/chatapp_styles.css"> 
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8H8YMLNYL6"></script>
    <script nonce="<%= nonce %>">

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Chat Room</title>
    <link href="https://fonts.googleapis.com/css2?family=Jersey+20&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/chatroom_styles.css">
</head>
<body>
    <div class="chat-container">
        <div class="chat-header">
            <h1><%= room.name %></h1>
            <a href="#" class="exit-button" title="Exit Chat" data-room-id="<%= room._id %>">Exit</a>
        </div>

        <div id="message-list" class="message-list"></div>

        <div class="chat-input">
            <textarea id="message-input" placeholder="Type your message..."></textarea>
            <button id="send-message">Send</button>
        </div>
    </div>

    <footer>
        <div class="footer-bottom">&copy; 2026</div>
    </footer>

    <script type="module" nonce="<%= nonce %>">

    import { marked } from "https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js";

    const roomId  = "<%= room._id %>";
    const isDemo  = <%= isDemo %>;

    function renderMarkdownMessage(msg, color) {
        const container = document.getElementById("message-list");
        const html = marked.parse(msg.text || '');
        const msgElem = document.createElement("div");
        msgElem.className = `message ${msg.isBot ? "bot-message" : "my-message"}`;
        msgElem.style.backgroundColor = color;
        msgElem.innerHTML =
            `<div class="message-user">${msg.isBot ? msg.username : (msg.username || roomId)}:</div>` +
            `<div class="message-text">${html}</div>`;
        container.appendChild(msgElem);
        container.scrollTop = container.scrollHeight;
    }

    function getSentimentColor(label, score) {
        let red = 0, green = 0, blue = 0;
        switch (label) {
            case 'LABEL_0':
                red = 255; green = 255 * (1 - score); blue = 255 * (1 - score); break;
            case 'LABEL_1':
                red = green = blue = 255 * score + 128 * (1 - score); break;
            case 'LABEL_2':
                red = 255 * (1 - score); green = 255; blue = 255 * (1 - score); break;
            default:
                red = green = blue = 200;
        }
        return `rgb(${Math.floor(red)}, ${Math.floor(green)}, ${Math.floor(blue)})`;
    }

    const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const socket = new WebSocket(`${wsProto}//${location.host}`);

    socket.onopen = async () => {
        console.log("[WS] Connected to room:", roomId);

        if (isDemo) {
            // Demo rooms show a greeting and don't load history
            renderMarkdownMessage(
                { username: "bot", text: "How are you doing today?", isBot: true, sentiment: { label: "neutral", score: 0 } },
                getSentimentColor("neutral", 0)
            );
        } else {
            // App rooms load previous messages from DB
            try {
                const res = await fetch(`/lobby/chat/${roomId}/messages`);
                if (res.ok) {
                    const conversation = await res.json();
                    if (conversation && conversation.messages) {
                        conversation.messages.forEach(msg => {
                            const color = getSentimentColor(
                                msg.sentiment?.label || 'LABEL_1',
                                parseFloat(msg.sentiment?.score) || 0.5
                            );
                            renderMarkdownMessage(msg, color);
                        });
                    }
                }
            } catch (err) {
                console.error("[DEBUG] Failed to load previous messages:", err);
            }
        }
    };

    socket.onmessage = (event) => {
        try {
            const message = JSON.parse(event.data);
            const color = getSentimentColor(message.sentiment?.label || "neutral", message.sentiment?.score || 0);
            renderMarkdownMessage(message, color);
        } catch (error) {
            console.error("[ERROR] Failed to process incoming message:", error);
        }
    };

    function sendMessage() {
        const input = document.getElementById("message-input");
        const text = input.value.trim();
        if (text) {
            socket.send(JSON.stringify({ roomId, text }));
            input.value = "";
        }
    }

    document.getElementById("send-message").addEventListener("click", sendMessage);
    document.getElementById("message-input").addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    });

    // ── Exit button ────────────────────────────────────────────────────────────
    document.querySelector('.exit-button').addEventListener('click', async (event) => {
        event.preventDefault();
        if (isDemo) {
            // Demo: delete all temp rooms, go back to login
            try { await fetch('/lobby/chat/demo-cleanup', { method: 'DELETE' }); } catch (_) {}
            window.location.href = '/login';
        } else {
            // App: keep room, go back to lobby
            window.location.href = '/app';
        }
    });

    </script>

    <script nonce="<%= nonce %>">
    // Hide footer when keyboard appears on mobile
    document.addEventListener('DOMContentLoaded', function() {
        var messageInput = document.getElementById('message-input');
        var footer = document.querySelector('footer');
        if (messageInput && footer) {
            messageInput.addEventListener('focus', function() {
                if (window.innerWidth <= 768) footer.style.display = 'none';
            });
            messageInput.addEventListener('blur', function() {
                if (window.innerWidth <= 768) footer.style.display = '';
            });
        }
    });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/login-style.css">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chat</title>
</head>
<body class="login-body">
    <div class="login-container">
        <h2>CHATAPP</h2>
        <div id="error-message" style="color: red; display: none; margin-bottom: 12px;"></div>
        <div class="button-group">
            <button id="enter-demo">Enter Chat Demo</button>
            <a href="/login/app" class="btn-link">Enter Chat App</a>
        </div>
    </div>

    <script nonce="<%= nonce %>">
        document.getElementById('enter-demo').addEventListener('click', async () => {
            const errorEl = document.getElementById('error-message');
            try {
                const res = await fetch('/start', { headers: { 'Accept': 'application/json' } });
                if (!res.ok) throw new Error('Failed to create demo room');
                const room = await res.json();
                window.location.href = `/lobby/chat/${room._id}`;
            } catch (err) {
                errorEl.textContent = err.message;
                errorEl.style.display = 'block';
            }
        });
    </script>
</body>
</html>
